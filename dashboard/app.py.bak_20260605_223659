            items.append(html.Div(style={'marginBottom':'10px'}, children=[
                html.Span(term, style={'fontWeight':600, 'color':'#0d4d7a', 'fontSize':'13px'}),
                html.Span(' — ' + defn, style={'fontSize':'13px', 'color':'#374151', 'lineHeight':1.45}),
